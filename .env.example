# ── Required ────────────────────────────────────────────────────────────────
# Price channel: pump/dump alerts and pending-trade (mempool) alerts.
PRICE_HOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ── Alert thresholds ────────────────────────────────────────────────────────
# blocks:percent pairs. 1 block = 12s. "Alert if price moves >= percent within that many blocks."
# Pumps are measured from the window's low, dumps from the window's high.
WINDOWS=1:2,5:3,25:4,300:7
# After an alert, the same subnet alerts again only when price is this much further from
# the last alerted price (either direction). Kills ping-pong on thin pools.
REALERT_STEP_PCT=3
# An episode (and its re-alert suppression) ends after this many quiet minutes.
EPISODE_TTL_MIN=15

# ── Subnet lifecycle alerts ─────────────────────────────────────────────────
# New subnet registered / deregistered / registration queued / dissolve scheduled / owner coldkey
# swap / owner or hotkey changed / renamed / emissions start / next in line to be pruned.
SUBNET_ALERTS=true
# Empty = post them in the news channel (NEWS_WEB_HOOK_URL). Set a webhook to give them their own channel.
SUBNET_WEB_HOOK_URL=

# ── Trend monitor (separate channel) ────────────────────────────────────────
# Sustained up/down trends over hours–days. Leave empty to disable.
TREND_WEB_HOOK_URL=
# window:board%:boardR²[:card%:cardR²] — the fitted trend line over the window must move at least
# board% with at least boardR² (how cleanly price follows the line) to show on the trend board;
# a card is posted once it also clears card%/cardR² (defaults to the board bar).
TREND_TIMEFRAMES=1h:2:0.85:4:0.9,3h:3.5:0.8:5:0.85,6h:6:0.8,12h:8:0.7,24h:10:0.65,3d:12:0.6
# Timeframes confirming a trend within this many hours update its card instead of posting anew.
TREND_STORY_HOURS=12
# Live trend board (one message at the bottom of the trend channel listing every trending subnet),
# refreshed every N seconds. 0 = off.
TREND_BOARD_SECONDS=60
# Reversal signals ("dump → pump starting"): price turns up after a drop of at least DUMP_PCT from
# the 24h high. Posted as cards, tracked for 24h, listed at the top of the trend board.
TREND_SIGNALS=true
TREND_SIGNAL_DUMP_PCT=5
# The turn up that fires it — window:min %:steadiness. 15m:2:0.8 = the last three 5-minute bars rise
# ≥2% in total, each higher than the last. A longer window (30m:2:0.85, 1h:2:0.85) fires later and
# less often, with slightly better signals.
TREND_SIGNAL_WINDOW=15m:2:0.8
# Also fire the moment price jumps this % off its recent 1-hour low — catches a sharp dump→pump "V"
# that the steady-rise window skips. 0 = off (window only).
TREND_SIGNAL_BOUNCE_PCT=3
# Dump → small pump, immediately: a fall of at least SHARP_DUMP_PCT within an hour arms a subnet, and the
# first TINY_PUMP_PCT (0.5%) rise off the post-dump low fires the signal on that block — no 15-minute window.
# (Backtest, 8 days: 8%+ dumps → 3.5 signals/day, 37–48% of trades won; 5% dumps had no edge.) 0 = off.
TREND_SIGNAL_SHARP_DUMP_PCT=8
TREND_SIGNAL_TINY_PUMP_PCT=0.5
# A big net sell-off as the signal itself: ≥ this many TAO net unstaked on a subnet in an hour, AND its price
# down ≥ MIN_DROP%. OFF by default — on 8 days of data, buying right after such sell-offs lost
# (22 events ≥500 τ: 24% higher after 24h, median −0.7%). 0 = off.
TREND_SIGNAL_DUMP_FLOW_TAO=0
TREND_SIGNAL_DUMP_FLOW_MIN_DROP_PCT=3
# Minimum hours between two signals on the same subnet. 0 = none: every signal is posted the moment it fires
# (the bot has the same setting, SIGNAL_COOLDOWN_HOURS).
TREND_SIGNAL_COOLDOWN_HOURS=0
# With no waiting period one move still gives ONE card: after a signal the subnet stays quiet until its price has
# fallen this % from its high since (a fresh dump) — then its next small pump is a new signal, even minutes later.
# 0 = every trigger posts every time (the same pump can then post 2-3 cards).
TREND_SIGNAL_REARM_PCT=3

# ── News monitor (third channel) ────────────────────────────────────────────
# Subnet channels on the Bittensor Discord → news webhook. Needs a Discord account that is a
# member of the server (use a separate alt account: automating a user account breaks Discord's
# ToS, so only the alt is at risk). Its token: Discord in the browser → F12 → Network → any
# api/v9 request → Request Headers → "authorization". Keep it secret.
NEWS_WEB_HOOK_URL=
NEWS_DISCORD_TOKEN=
# Optional: server id or exact name if the account is in several Bittensor-named servers.
NEWS_GUILD_ID=
# A team post without a link or announcement words counts as news from this many characters.
NEWS_MIN_TEAM_CHARS=120
# X accounts watched directly (new posts / reposts / replies / quotes → news cards). A new look at each every N seconds,
# WITHOUT waiting for the previous look to come back (a look takes 2-4 s on the free fxtwitter API), so 0.5 means a fresh
# timeline every ~0.7 s. Looks are overlapped (up to 8); a 429 from the API pauses them all for the time it asks.
NEWS_X_ACCOUNTS=const_reborn
NEWS_X_POLL_SECONDS=0.5
# Every subnet's own X account too: its post is news the moment it is on X — someone shares it in the subnet's channel
# minutes later (20 Oct: @vidaio_ posted at 15:03, the share in #85 came at 15:04 while bots were already buying SN85).
# The accounts are found from each subnet's website (the X account it links most; else its GitHub README) and only
# watched when the X profile points back to the subnet (its website, "SN85" in the bio, or its name): 61 of 128 on 20 Oct.
# Kept in data/x_subnets.json and looked up again daily. One account after another, NEWS_X_SUBNET_RATE timeline requests
# a second in all (6: ~65 accounts, each every ~11 s); the free API fails ~40% of requests, so a failed look is tried
# again at once (up to 2 times). Own posts and quotes count — not replies or reposts. They reach
# the bots as kind "x_subnet"; a later Discord share of the same post is not reported again.
NEWS_X_SUBNETS=true
NEWS_X_SUBNET_RATE=6
# Add or correct accounts by hand: netuid:handle, comma-separated; netuid:- = no account for that subnet. Hand entries are
# watched without the profile check. 20 Oct: SN14's site does not link its X account; @NATIXNetwork (SN72) and
# @TatsuEcosystem (SN108) are found but their profiles do not name the subnet.
NEWS_X_SUBNET_HANDLES=14:cacheon_ai,72:NATIXNetwork,108:TatsuEcosystem
# Important news only: each post is judged before it goes to the bots — the AI uses its own judgment (can this move the
# price now?); typical examples: a product launch, big progress,
# funding / a new investor, revenue / customers / contracts, a notable partnership, a listing, a buyback / burn; not a
# reply, a dev note, a reminder, or a share of an old post (21 Oct: 2 of 21 news trades made money; SN124 was a 2-day-old
# quarterly update shared in Discord). Claude judges when ANTHROPIC_API_KEY is set (console.anthropic.com → API keys);
# without it, or when it does not answer within NEWS_AI_TIMEOUT seconds, keyword rules do. The verdict is on every card
# ("News check") and the bots trade only what is judged important (their NEWS_IMPORTANT_ONLY).
# The AI: OpenRouter when OPENROUTER_API_KEY is set (openrouter.ai → Keys; pay with credits), else Claude directly with
# ANTHROPIC_API_KEY. NEWS_AI_MODEL empty = openai/gpt-6.1-sol on OpenRouter (claude-opus-5-5 with an Anthropic key).
# Per post (~1,000 tokens in, ~50 out; 150-250 posts a day): openai/gpt-6.1-sol ~2.9 s, ~$0.0015; anthropic/claude-haiku-5.5
# ~2.3 s (via OpenRouter, measured 21 Oct), ~$0.00013 (~$1 a month);
# anthropic/claude-sonnet-5.5 ~$0.0026 (~$20 a month); anthropic/claude-opus-5.5 ~$0.005-0.01, slower (~$40-75 a month).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
NEWS_AI_MODEL=openai/gpt-6.1-sol
NEWS_AI_TIMEOUT=8
# The bots wait for the verdict: this many identical requests go at once and the first answer is used (1 = one request).
# 21 Oct, 6 real posts × 2: median 2.9 → 2.4 s, slowest 5.7 → 4.1 s, the same verdicts; about twice the cost (~$0.003/post).
NEWS_AI_RACE=2
# News feed for the trading bots (sn_trader news trading): every news card about a subnet is sent to the connected
# bots the moment it is detected, before the card is posted. 0 = off. The bots connect to http://<this machine>:<port>/news
# with the token (set the same NEWS_FEED_TOKEN in their env). Never served without a token.
NEWS_FEED_PORT=8795
NEWS_FEED_TOKEN=

# ── Mempool early warning ───────────────────────────────────────────────────
# Alert on pending stakes/unstakes before they land, when their exact predicted impact >= this.
MEMPOOL_ALERTS=true
MEMPOOL_MIN_PCT=2
MEMPOOL_POLL_MS=200
# Dedicated connections for mempool polling (public lite/finney nodes throttle it per connection).
MEMPOOL_ENDPOINTS=wss://archive.chain.opentensor.ai:443,wss://bittensor-finney.api.onfinality.io/public-ws

# ── Filters ─────────────────────────────────────────────────────────────────
# Ignore subnets whose pool holds less than this many TAO (0 = watch everything).
MIN_POOL_TAO=0
# Comma list / ranges, e.g. 1,4,8-12
ONLY_NETUIDS=
EXCLUDE_NETUIDS=

# ── Pings ───────────────────────────────────────────────────────────────────
# Ping when a move is >= MENTION_PCT (0 = never). MENTION: @everyone, @here or <@&ROLE_ID>
MENTION_PCT=0
MENTION=

# ── Nodes ───────────────────────────────────────────────────────────────────
# Every block is raced across all of these; the first to deliver wins.
RPC_ENDPOINTS=wss://lite.chain.opentensor.ai:443,wss://archive.chain.opentensor.ai:443,wss://entrypoint-finney.opentensor.ai:443,wss://bittensor-finney.api.onfinality.io/public-ws
ARCHIVE_ENDPOINT=wss://archive.chain.opentensor.ai:443

# ── Misc ────────────────────────────────────────────────────────────────────
STARTUP_MESSAGE=true
# Console only, nothing posted to Discord.
DRY_RUN=false
